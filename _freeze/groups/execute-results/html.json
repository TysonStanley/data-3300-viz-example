</td>\n      <td>4496</td>\n    </tr>\n    <tr>\n      <th>226</th>\n      <td>11</td>\n      <td>West</td>\n      <td>5594</td>\n    </tr>\n    <tr>\n      <th>227</th>\n      <td>29</td>\n      <td>North</td>\n      <td>5284</td>\n    </tr>\n    <tr>\n      <th>228</th>\n      <td>25</td>\n      <td>South</td>\n      <td>4982</td>\n    </tr>\n    <tr>\n      <th>229</th>\n      <td>18</td>\n      <td>South</td>\n      <td>4676</td>\n    </tr>\n    <tr>\n      <th>230</th>\n      <td>60</td>\n      <td>West</td>\n      <td>4516</td>\n    </tr>\n    <tr>\n      <th>231</th>\n      <td>37</td>\n      <td>West</td>\n      <td>4738</td>\n    </tr>\n    <tr>\n      <th>232</th>\n      <td>57</td>\n      <td>East</td>\n      <td>5350</td>\n    </tr>\n    <tr>\n      <th>233</th>\n      <td>30</td>\n      <td>North</td>\n      <td>5878</td>\n    </tr>\n    <tr>\n      <th>234</th>\n      <td>56</td>\n      <td>South</td>\n      <td>11573</td>\n    </tr>\n    <tr>\n      <th>235</th>\n      <td>18</td>\n      <td>East</td>\n      <td>5302</td>\n    </tr>\n    <tr>\n      <th>236</th>\n      <td>5</td>\n      <td>South</td>\n      <td>4614</td>\n    </tr>\n    <tr>\n      <th>237</th>\n      <td>27</td>\n      <td>North</td>\n      <td>5651</td>\n    </tr>\n    <tr>\n      <th>238</th>\n      <td>15</td>\n      <td>West</td>\n      <td>4442</td>\n    </tr>\n    <tr>\n      <th>239</th>\n      <td>2</td>\n      <td>North</td>\n      <td>5610</td>\n    </tr>\n  </tbody>\n</table>\n</div>\n```\n:::\n:::\n\n\n:::\n\n::: {.guess}\n**Your guess:** Which region has the highest typical daily sales? Which region is the *least predictable* from day to day? Do any regions have unusual days?\n:::\n\n## Step 1: A bar chart of averages\n\n::: {.callout-tip collapse=\"true\"}\n## Reveal the bar chart\n\n::: {#e7126c8e .cell execution_count=3}\n``` {.python .cell-code}\nfig, ax = plt.subplots()\nsns.barplot(data=sales, x=\"region\", y=\"daily_sales\", order=region_order,\n            hue=\"region\", palette=palette, errorbar=None, ax=ax, legend=False)\nfor container in ax.containers:\n    ax.bar_label(container, fmt=\"${:,.0f}\", padding=3)\nax.set(xlabel=\"\", ylabel=\"Average daily sales ($)\", title=\"Average daily sales by region\")\nax.set_ylim(0, 6800)\nplt.show()\n```\n\n::: {.cell-output .cell-output-display}\n![](groups_files/figure-html/cell-4-output-1.png){width=1076 height=626}\n:::\n:::\n\n\n[The bar chart answers \"which group has the biggest average?\" instantly, far faster than the table. But the regions look *about the same*. Is that the whole story?]{.reveal-note}\n:::\n\n## Step 2: Boxplots show the spread\n\n::: {.callout-tip collapse=\"true\"}\n## Reveal the boxplots\n\n::: {#5fbde162 .cell execution_count=4}\n``` {.python .cell-code}\nfig, ax = plt.subplots()\nsns.boxplot(data=sales, x=\"region\", y=\"daily_sales\", order=region_order,\n            hue=\"region\", palette=palette, width=0.55, fliersize=0, ax=ax, legend=False)\nsns.stripplot(data=sales, x=\"region\", y=\"daily_sales\", order=region_order,\n              color=\"black\", alpha=0.35, size=3.5, jitter=0.18, ax=ax)\nax.set(xlabel=\"\", ylabel=\"Daily sales ($)\",\n       title=\"Similar averages, very different stories\")\nplt.show()\n```\n\n::: {.cell-output .cell-output-display}\n![](groups_files/figure-html/cell-5-output-1.png){width=1091 height=626}\n:::\n:::\n\n\n[Now the real differences appear:]{.reveal-note}\n\n- **West** is wildly inconsistent: some days are the best in the company, others the worst. Its average hides that.\n- **South** is actually the *lowest* on a normal day. Its average is propped up by **5 huge outlier days** (a sale event? a data entry error?), worth investigating.\n- **North** and **East** are steady and predictable.\n\n[A bar chart of means compresses each group to **one number**. A boxplot shows the **median, spread, and outliers**, and overlaying the points shows every single day.]{.reveal-note}\n:::\n\n::: {.callout-note collapse=\"true\"}\n## The numbers, for comparison\n\nThe same story *is* in the numbers if you know which ones to compute. But you need to already suspect what to look for:\n\n::: {#8851f762 .cell execution_count=5}\n``` {.python .cell-code}\n(sales.groupby(\"region\")[\"daily_sales\"]\n      .agg(mean=\"mean\", median=\"median\", sd=\"std\", min=\"min\", max=\"max\")\n      .loc[region_order]\n      .round(0))\n```\n\n::: {.cell-output .cell-output-display execution_count=5}\n```{=html}\n<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>mean</th>\n      <th>median</th>\n      <th>sd</th>\n      <th>min</th>\n      <th>max</th>\n    </tr>\n    <tr>\n      <th>region</th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>North</th>\n      <td>5214.0</td>\n      <td>5233.0</td>\n      <td>400.0</td>\n      <td>4233</td>\n      <td>5948</td>\n    </tr>\n    <tr>\n      <th>East</th>\n      <td>5434.0</td>\n      <td>5418.0</td>\n      <td>354.0</td>\n      <td>4647</td>\n      <td>6142</td>\n    </tr>\n    <tr>\n      <th>West</th>\n      <td>5072.0</td>\n      <td>5270.0</td>\n      <td>1495.0</td>\n      <td>1452</td>\n      <td>9617</td>\n    </tr>\n    <tr>\n      <th>South</th>\n      <td>5177.0</td>\n      <td>4667.0</td>\n      <td>1689.0</td>\n      <td>3781</td>\n      <td>11573</td>\n    </tr>\n  </tbody>\n</table>\n</div>\n```\n:::\n:::\n\n\n:::\n\n",
